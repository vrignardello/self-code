{
  "name": "self-code",
  "version": "0.1.0",
  "private": true,
  "description": "A local JavaScript and TypeScript workspace",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "dompurify": "^3.4.17",
    "monaco-editor": "^0.57.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  },
  "overrides": { "dompurify": "$dompurify" },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@45.0.0": true
  }
}
